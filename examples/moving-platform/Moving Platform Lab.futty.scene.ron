            id: "6f0a056c-ae4a-48b0-9547-ee753892b02a",
            name: "Reach the landing",
            kind: Script,
        ),
    ],
    script_sources: {
        "44c4606c-bf85-42f2-9894-5fa217413442": "fn on_start(entity) {\n    this.origin = get_position(entity);\n    this.elapsed = 0.0;\n}\n\nfn on_fixed_update(entity, dt) {\n    this.elapsed = (this.elapsed + dt) % 4.0;\n    let progress = (1.0 - cos(this.elapsed * 1.57079632679)) * 0.5;\n    let start = this.origin;\n    set_position(entity, start.x + 3.2 * progress, start.y + 1.8 * progress, start.z);\n}\n",
        "6f0a056c-ae4a-48b0-9547-ee753892b02a": "fn on_update(entity, dt) {\n    let position = get_position(entity);\n    if position.y < -3.0 {\n        finish_game(\"failure\");\n    } else if position.x >= 4.4 && position.x <= 6.2 && position.y >= 2.04 && position.y < 2.12 {\n        finish_game(\"success\");\n    }\n}\n",
    },
    sky: false,
)