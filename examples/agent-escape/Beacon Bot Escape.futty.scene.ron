        (
            id: "190a27e9-7a1c-4582-ba07-18e759d04aa2",
            name: "Door control",
            kind: Script,
        ),
    ],
    script_sources: {
        "190a27e9-7a1c-4582-ba07-18e759d04aa2": "fn on_start(entity) {\n    this.opened = false;\n}\n\nfn on_message(entity, sender, name) {\n    if name == \"open\" && !this.opened {\n        this.opened = true;\n        translate(entity, 0.0, 3.2, 0.0);\n    }\n}",
        "c89a3359-e183-4c34-8db1-a935dd5d7ea8": "fn on_start(entity) {\n    this.unlocked = false;\n    this.escaped = false;\n    set_hud(\"objective\", \"Find the amber switch [E]\");\n}\n\nfn on_update(entity, dt) {\n    let p = get_position(entity);\n    if !this.unlocked && input_pressed(\"Interact\") {\n        if p.z > 0.25 && p.z < 2.45 && abs(p.x - 1.2) < 1.7 {\n            let door = find_tag(\"exit-door\");\n            if door != () {\n                send_event(door, \"open\");\n                this.unlocked = true;\n                set_hud(\"objective\", \"Walk through the open door\");\n            }\n        } else {\n            set_hud(\"objective\", \"Move closer to the switch\");\n        }\n    }\n    if this.unlocked && !this.escaped && p.z < -4.25 {\n        this.escaped = true;\n        set_hud(\"objective\", \"ESCAPE COMPLETE\");\n        finish_game(\"success\");\n        log(\"escape_complete\");\n    }\n}",
    },
    main_camera: Some("b63e3b2d-0b60-4b09-8439-1bdfa8979316"),
