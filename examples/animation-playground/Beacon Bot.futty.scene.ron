    script_sources: {
        "9322460c-839c-4ecd-9672-af3a53a7e9a7": r#"
fn on_start(entity) {
    set_hud("clip", "IDLE");
}

fn on_update(entity, dt) {
    if hud_pressed("idle") {
        play_animation(entity, 0, true);
        set_hud("clip", "IDLE");
    } else if hud_pressed("walk") {
        play_animation(entity, 1, true);
        set_hud("clip", "WALK");
    } else if hud_pressed("signal") {
        play_animation(entity, 2, false);
        set_hud("clip", "SIGNAL");
    }
}
"#,
